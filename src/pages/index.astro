---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { APP_NAME, APP_STORE_URL, DEFAULT_DESCRIPTION, SITE_URL } from '../config';

import appIcon from '../assets/app-icon.png';
import waving from '../assets/mascot/waving.png';
import scanning from '../assets/mascot/scanning.png';
import inviting from '../assets/mascot/inviting.png';
import celebrating from '../assets/mascot/celebrating.png';
import sleeping from '../assets/mascot/sleeping.png';
import waiting from '../assets/mascot/waiting.png';
import screenNearby from '../assets/screens/cerca.png';
import screenPlans from '../assets/screens/planes.png';
import screenChat from '../assets/screens/chat.png';

// Fila de accesos bajo el título (como la de modelos en apple.com/ipad).
const chips = [
  { href: '#radar', label: 'Radar', img: scanning },
  { href: '#conecta', label: 'Conecta', img: waving },
  { href: '#planes', label: 'Planes', img: inviting },
  { href: '#chat', label: 'Chat', img: celebrating },
  { href: '#invisible', label: 'Modo invisible', img: sleeping },
  { href: '#privacidad', label: 'Privacidad', img: waiting },
];

// Pantallas del encabezado (capturas del modo demo de la app, con cuentas ficticias).
// El orden es el visual: izquierda, centro (al frente) y derecha.
const screens = [
  { pos: 'left', img: screenPlans, caption: 'Planes en el mapa',
    alt: 'Pantalla Planes de Gisi: un mapa con planes cercanos, cada uno con su nombre y categoría, como un café, una rodada en bici y una expo.' },
  { pos: 'center', img: screenNearby, caption: 'Radar de quién está cerca',
    alt: 'Pantalla Cerca de ti de Gisi: el radar muestra a ocho personas cerca, con su distancia aproximada.' },
  { pos: 'right', img: screenChat, caption: 'Chat con tus conexiones',
    alt: 'Chat de Gisi entre dos personas que conectaron: mensajes para quedar en un plan de café y un sticker de la mascota.' },
];

// Tarjetas de la galería "Conoce a Gisi."
const cards = [
  {
    id: 'radar', theme: 'dark', img: scanning, eyebrow: 'Radar',
    title: 'Mira quién está cerca. Ahora mismo.',
    text: 'Enciende tu radar y Gisi detecta por Bluetooth a las personas a tu alrededor.',
  },
  {
    id: 'conecta', theme: 'pink', img: waving, eyebrow: 'Amistad · Networking · Citas',
    title: 'Conecta a tu manera.',
    text: 'Elige qué buscas: amistad, networking o citas. Si el interés es mutuo, conectan y se abre el chat.',
  },
  {
    id: 'planes', theme: 'blush', img: inviting, eyebrow: 'Planes',
    title: 'Planes en tu zona.',
    text: 'Únete a un plan en el mapa o crea el tuyo, y conózcanse en el chat del grupo.',
  },
  {
    id: 'chat', theme: 'light', img: celebrating, eyebrow: 'Chat',
    title: 'Habla a tu manera.',
    text: 'Fotos, notas de voz y stickers de Gisi, o crea los tuyos con tus fotos.',
  },
  {
    id: 'invisible', theme: 'white', img: sleeping, eyebrow: 'Modo invisible',
    title: 'Tú decides cuándo te ven.',
    text: 'Apaga el radar o ponte invisible, y elige si muestras tu nombre antes de conectar.',
  },
];

const steps = [
  { n: '1', title: 'Enciende tu radar', text: 'Gisi encuentra a las personas que también lo tienen encendido cerca de ti.' },
  { n: '2', title: 'Mira qué busca', text: 'Cada perfil dice si busca amistad, networking o citas. Revisa sus fotos e intereses.' },
  { n: '3', title: 'Conecten y hablen', text: 'Si el interés es mutuo, se abre el chat para conocerse antes de verse.' },
];

const privacy = [
  { title: 'Proximidad, no posición.', text: 'El radar sabe que alguien está cerca, no dónde. Tu ubicación no se comparte con nadie.' },
  { title: 'Chats solo con tus conexiones.', text: 'Solo tú y tus conexiones ven sus conversaciones y fotos.' },
  { title: 'Bloquea cuando quieras.', text: 'Bloquea o reporta a cualquiera, y deshazlo desde Configuración si fue un error.' },
  { title: 'Tu cuenta, tus datos.', text: 'Puedes eliminar tu cuenta desde la app, con tu perfil, conexiones y mensajes.' },
];

const appJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MobileApplication',
  name: APP_NAME,
  operatingSystem: 'iOS 17 o posterior',
  applicationCategory: 'SocialNetworkingApplication',
  description: DEFAULT_DESCRIPTION,
  url: SITE_URL,
  downloadUrl: APP_STORE_URL,
  inLanguage: ['es', 'en', 'pt-BR', 'fr', 'de'],
};
---

<Base jsonLd={appJsonLd}>
  <!-- Encabezado: título, descarga y la app en tres pantallas -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero-copy">
      <h1 id="hero-title" class="display">Gisi</h1>
      <p class="hero-lead">Conoce a quien tienes cerca.</p>
      <p class="hero-sub">Enciende tu radar y haz amigos, networking o encuentra una cita con quien está a unos metros. Y únete a planes en tu zona.</p>
      <div class="hero-cta">
        <a class="btn" href={APP_STORE_URL} rel="noopener">Descargar en la App Store</a>
        <a href="#como-funciona" class="link-more">Cómo funciona</a>
      </div>
    </div>

    <div class="phones" role="list">
      {screens.map((sc) => (
        <figure class={`phone phone-${sc.pos}`} role="listitem">
          <div class="phone-frame">
            <Image
              src={sc.img}
              alt={sc.alt}
              widths={[320, 480, 640, 960]}
              sizes={sc.pos === 'center' ? '(max-width: 734px) 62vw, 320px' : '(max-width: 734px) 48vw, 270px'}
              loading="eager"
              fetchpriority={sc.pos === 'center' ? 'high' : 'auto'}
            />
          </div>
          <figcaption>{sc.caption}</figcaption>
        </figure>
      ))}
    </div>

    <div class="container">
      <ul class="chips" aria-label="Funciones">
        {chips.map((c) => (
          <li>
            <a href={c.href}>
              <Image src={c.img} alt="" width={64} height={64} widths={[64, 128]} sizes="64px" />
              <span>{c.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Galería de funciones -->
  <section class="section section-alt" aria-labelledby="gallery-title">
    <div class="container section-head">
      <h2 id="gallery-title" class="headline">Conoce a Gisi.</h2>
      <a href={APP_STORE_URL} rel="noopener" class="link-more">Descargar la app</a>
    </div>

    <div class="gallery" data-gallery>
      <ul class="gallery-track" data-track>
        {cards.map((c) => (
          <li id={c.id} class={`card card-${c.theme}`}>
            <div class="card-copy">
              <p class="card-eyebrow">{c.eyebrow}</p>
              <h3 class="card-title">{c.title}</h3>
              <p class="card-text">{c.text}</p>
            </div>
            <Image class="card-img" src={c.img} alt="" width={260} height={260} widths={[260, 520]} sizes="260px" />
          </li>
        ))}
      </ul>
      <div class="paddles container">
        <button type="button" class="paddle" data-prev aria-label="Anterior">‹</button>
        <button type="button" class="paddle" data-next aria-label="Siguiente">›</button>
      </div>
    </div>
  </section>

  <!-- Cómo funciona -->
  <section id="como-funciona" class="section" aria-labelledby="steps-title">
    <div class="container">
      <h2 id="steps-title" class="headline">Así de fácil.</h2>
      <ol class="steps">
        {steps.map((s) => (
          <li>
            <span class="step-n" aria-hidden="true">{s.n}</span>
            <h3 class="title">{s.title}</h3>
            <p class="body-2">{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Privacidad -->
  <section id="privacidad" class="section section-alt" aria-labelledby="privacy-title">
    <div class="container">
      <p class="eyebrow">Privacidad</p>
      <h2 id="privacy-title" class="headline">Cerca, pero a tu ritmo.</h2>
      <ul class="privacy">
        {privacy.map((p) => (
          <li>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </li>
        ))}
      </ul>
      <a href="/privacidad" class="link-more more">Lee nuestra política de privacidad</a>
    </div>
  </section>

  <!-- Descarga -->
  <section class="section download" aria-labelledby="download-title">
    <div class="container download-inner">
      <Image src={appIcon} alt="Ícono de Gisi" class="download-icon" width={128} height={128} widths={[128, 256]} sizes="128px" />
      <h2 id="download-title" class="headline">Descarga Gisi.</h2>
      <p class="lead">Disponible para iPhone en la App Store.</p>
      <p class="langs">En español, inglés, portugués, francés y alemán.</p>
      <a class="btn btn-dark" href={APP_STORE_URL} rel="noopener">Descargar en la App Store</a>
      <Image src={waving} alt="" class="download-mascot" width={140} height={140} widths={[140, 280]} sizes="140px" />
    </div>
  </section>
</Base>

<script>
  // Flechas de la galería: desplazan una tarjeta (sin JS se puede deslizar igual).
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((g) => {
    const track = g.querySelector<HTMLElement>('[data-track]');
    if (!track) return;
    const step = () => (track.querySelector('li')?.getBoundingClientRect().width ?? 300) + 20;
    g.querySelector('[data-prev]')?.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    g.querySelector('[data-next]')?.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
  });
</script>

<style>
  /* ---------- Encabezado ---------- */
  .hero {
    padding: 88px 0 72px;
    overflow: hidden;
    /* Resplandor rosa detrás de los teléfonos */
    background:
      radial-gradient(60% 42% at 50% 72%, rgba(255, 46, 126, 0.16) 0%, rgba(255, 46, 126, 0) 70%),
      var(--bg);
  }
  .hero-copy { text-align: center; }
  .hero-lead {
    font-size: clamp(28px, 4vw, 40px);
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 10px 0 0;
    background: var(--pink-grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero-sub {
    font-size: clamp(17px, 1.8vw, 21px);
    line-height: 1.38;
    color: var(--text-2);
    max-width: 34em;
    margin: 16px auto 0;
  }
  .hero-cta { display: flex; justify-content: center; align-items: center; gap: 24px; flex-wrap: wrap; margin-top: 28px; font-size: 19px; }

  /* Tres iPhones: el del centro al frente, los laterales detrás y un poco más abajo */
  .phones {
    --w: 300px;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    margin: 64px auto 0;
    padding: 0 22px;
  }
  .phone { margin: 0; display: flex; flex-direction: column; align-items: center; flex-shrink: 0; }
  .phone-center { width: var(--w); z-index: 2; }
  .phone-left,
  .phone-right { width: calc(var(--w) * 0.86); margin-top: 56px; z-index: 1; }
  .phone-left { margin-right: -28px; }
  .phone-right { margin-left: -28px; }
  .phone-left .phone-frame { transform: rotate(-4deg); }
  .phone-right .phone-frame { transform: rotate(4deg); }

  .phone-frame {
    width: 100%;
    /* Bisel negro con el radio de las esquinas de un iPhone */
    padding: 3.6%;
    border-radius: 15.5% / 7.2%;
    background: #1d1d1f;
    box-shadow:
      inset 0 0 0 1.5px #3a3a3c,
      0 2px 4px rgba(0, 0, 0, 0.08),
      0 30px 60px -12px rgba(60, 10, 35, 0.35);
  }
  .phone-frame img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1320 / 2868;
    border-radius: 12.6% / 5.8%;
  }
  .phone figcaption {
    margin-top: 18px;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-2);
    letter-spacing: -0.01em;
    text-align: center;
  }
  @media (prefers-reduced-motion: no-preference) {
    .phone { animation: phone-in 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) both; }
    .phone-left { animation-delay: 0.12s; }
    .phone-right { animation-delay: 0.2s; }
  }
  @keyframes phone-in {
    from { opacity: 0; translate: 0 40px; }
    to { opacity: 1; translate: 0 0; }
  }

  .chips {
    display: flex;
    justify-content: safe center;
    gap: 40px;
    list-style: none;
    margin: 64px 0 0;
    padding: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .chips::-webkit-scrollbar { display: none; }
  .chips a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    color: var(--text);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.016em;
    white-space: nowrap;
  }
  .chips a:hover { color: var(--link); text-decoration: none; }
  .chips img { width: 64px; height: 64px; object-fit: contain; transition: transform 0.2s ease; }
  .chips a:hover img { transform: translateY(-3px); }

  /* ---------- Galería ---------- */
  .gallery-track {
    display: flex;
    gap: 20px;
    list-style: none;
    margin: 0;
    padding: 4px max(22px, calc((100vw - var(--content)) / 2)) 24px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: max(22px, calc((100vw - var(--content)) / 2));
    scrollbar-width: none;
  }
  .gallery-track::-webkit-scrollbar { display: none; }

  .card {
    position: relative;
    flex: 0 0 min(372px, 82vw);
    height: 500px;
    border-radius: var(--radius-card);
    padding: 30px;
    overflow: hidden;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .card:hover { transform: scale(1.01); box-shadow: 2px 4px 16px rgba(0, 0, 0, 0.12); }
  .card-eyebrow { font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; margin: 0 0 8px; opacity: 0.8; }
  .card-title { font-size: 28px; line-height: 1.14; font-weight: 700; margin: 0; letter-spacing: 0.007em; }
  .card-text { font-size: 17px; margin: 10px 0 0; opacity: 0.85; }
  .card-img { width: 230px; height: 230px; object-fit: contain; align-self: center; margin-bottom: -6px; }

  .card-dark { background: radial-gradient(120% 80% at 50% 100%, #4a0f2a 0%, #000 60%); color: #f5f5f7; }
  .card-dark .card-eyebrow { color: #ff6ba3; opacity: 1; }
  .card-pink { background: var(--pink-grad); color: #fff; }
  .card-blush { background: #ffe1ec; color: var(--text); }
  .card-blush .card-eyebrow { color: var(--pink-deep); opacity: 1; }
  .card-light { background: #e8e8ed; color: var(--text); }
  .card-white { background: #fff; color: var(--text); }

  .paddles { display: flex; justify-content: flex-end; gap: 14px; margin-top: 8px; }
  .paddle {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 0;
    background: rgba(210, 210, 215, 0.64);
    color: rgba(0, 0, 0, 0.56);
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
  }
  .paddle:hover { background: rgba(223, 223, 227, 0.7); color: rgba(0, 0, 0, 0.64); }

  /* ---------- Pasos ---------- */
  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    list-style: none;
    margin: 56px 0 0;
    padding: 0;
  }
  .step-n {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--pink-grad);
    color: #fff;
    font-weight: 700;
    margin-bottom: 18px;
  }
  .steps .title { font-size: 24px; }

  /* ---------- Privacidad ---------- */
  .privacy {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    list-style: none;
    margin: 48px 0 32px;
    padding: 0;
  }
  .privacy li { background: #fff; border-radius: 18px; padding: 28px; }
  .privacy h3 { font-size: 21px; line-height: 1.19; margin: 0 0 8px; }
  .privacy p { margin: 0; color: var(--text-2); }
  .more { font-size: 19px; }

  /* ---------- Descarga ---------- */
  .download { text-align: center; overflow: hidden; }
  .download-inner { display: flex; flex-direction: column; align-items: center; position: relative; }
  .download-icon { width: 128px; height: 128px; border-radius: 28px; box-shadow: 0 10px 30px rgba(255, 46, 126, 0.3); margin-bottom: 28px; }
  .download .btn { margin-top: 28px; }
  .langs { margin: 8px 0 0; color: var(--text-2); font-size: 17px; }
  .download-mascot { width: 140px; height: 140px; object-fit: contain; margin-top: 48px; }

  @media (max-width: 734px) {
    .hero { padding: 56px 0 48px; }
    /* En el celular: el del centro al frente y los laterales asoman por detrás */
    .phones { --w: 62vw; margin-top: 44px; padding: 0; }
    .phone-left,
    .phone-right { width: calc(var(--w) * 0.78); margin-top: 40px; flex-shrink: 0; }
    .phone-left { margin-right: -24vw; }
    .phone-right { margin-left: -24vw; }
    .phone-left .phone-frame { transform: rotate(-5deg); }
    .phone-right .phone-frame { transform: rotate(5deg); }
    .phone-left figcaption,
    .phone-right figcaption { visibility: hidden; }
    .chips { gap: 28px; margin-top: 44px; }
    .card { height: 460px; padding: 24px; }
    .card-title { font-size: 24px; }
    .steps, .privacy { grid-template-columns: 1fr; }
    .paddles { display: none; }
  }
</style>
